
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model PointHistory {
  id         Int      @id @default(autoincrement())
  userId     Int
  amount     Int
  policyType String
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([policyType])
}